# Copy to .env for local runs. Never commit real values.
# In GitHub Actions these are provided as repository secrets with the same names.

# Regulations.gov API key (https://open.gsa.gov/api/regulationsgov/)
REGULATIONS_GOV_API_KEY=

# Anthropic API key used for segmentation, classification and summaries
ANTHROPIC_API_KEY=

# Optional overrides
# Model used for classification stages (defaults to the value in prompts/config.json)
# LLM_MODEL=
# Docket to track (defaults to the value in scripts/pipeline/config.py)
# DOCKET_ID=FDA-2026-N-7874
